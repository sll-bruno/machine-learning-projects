    "\n",
    "        image, label, metadata= val_data[idx]\n",
    "        axes[i, j].imshow(denormalize(image))\n",
    "        axes[i, j].set_title(f\"Label: {label.item()}\")\n",
    "\n",
    "fig.suptitle(\"Sample Images from Training and Validation Sets\", fontsize=16)\n",
    "\n",
    "plt.show()\n"
